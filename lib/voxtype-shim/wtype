#!/bin/bash
# Shim do wtype para o VoxType (ver voxtype.service.d/xwayland-paste.conf).
# wtype digita por um keymap virtual que apps XWayland (ex.: Waterfox com
# MOZ_ENABLE_WAYLAND=0) ignoram -> cirílico vira números. Nesses casos:
# copia o texto com wl-copy e cola com Ctrl+V enviado pelo próprio Hyprland.
REAL=/usr/bin/wtype
LOG="${XDG_RUNTIME_DIR:-/tmp}/voxtype-wtype-shim.log"

# Só intercepta digitação de texto puro (sem -k/-M/-P/-s etc.)
text_mode=1
for a in "$@"; do
  case "$a" in -k|-M|-m|-P|-p|-s) text_mode=0 ;; esac
done

read -r xw cls < <(hyprctl activewindow -j 2>/dev/null | jq -r '"\(.xwayland // false) \(.class // "")"')
echo "$(date +%T) xwayland=$xw class=$cls text_mode=$text_mode args=$*" >> "$LOG"

# Electron nativo (Discord, Obsidian) perde a 1ª letra com wtype mesmo com -s 80
# -> também cola via clipboard.
paste=0
[[ $xw == true ]] && paste=1
case "$cls" in discord|vesktop|md.obsidian.Obsidian) paste=1 ;; esac

if [[ $paste == 1 && $text_mode == 1 && $# -gt 0 ]]; then
  text="${!#}"
  # wl-copy fica em segundo plano servindo o clipboard; sem soltar stdout/stderr
  # ele segura o pipe do VoxType, que espera para sempre (só 1ª vez funciona)
  printf '%s' "$text" | wl-copy >/dev/null 2>&1
  sleep 0.05
  hyprctl eval 'hl.dispatch(hl.dsp.send_key_state({ mods = "CTRL", key = "V", state = "down" })) hl.timer(function() hl.dispatch(hl.dsp.send_key_state({ mods = "CTRL", key = "V", state = "up" })) end, { timeout = 50, type = "oneshot" })' >/dev/null
  exec >/dev/null 2>&1
  exit 0
fi

# Apps Wayland nativos (Discord, Obsidian...) perdem a 1ª tecla se ela chega
# antes de processarem o keymap virtual recém-enviado -> "Привет" vira "ривет".
# -s no início faz o wtype esperar após subir o keymap, antes de digitar.
if [[ $text_mode == 1 && $# -gt 0 ]]; then
  exec "$REAL" -s 150 "$@"
fi
exec "$REAL" "$@"
