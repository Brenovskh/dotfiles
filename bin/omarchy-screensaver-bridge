#!/usr/bin/env python3
# Bridges org.freedesktop.ScreenSaver Inhibit/UnInhibit (used by Firefox/
# Waterfox/Chromium for the Wake Lock API and video playback) into the
# Omarchy shell's native "stay awake" state, since nothing else on this
# Hyprland session owns that D-Bus name. Without this, browsers call
# Inhibit() into the void and the idle service locks the screen anyway.

import dbus
import dbus.service
import dbus.mainloop.glib
from gi.repository import GLib
import subprocess

BUS_NAME = "org.freedesktop.ScreenSaver"
OBJECT_PATH = "/org/freedesktop/ScreenSaver"
IFACE = "org.freedesktop.ScreenSaver"


def set_stay_awake(enabled: bool) -> None:
    r = subprocess.run(
        ["omarchy", "toggle", "idle", "stay-awake" if enabled else "allow-idle"],
        check=False,
        capture_output=True,
        text=True,
    )
    print(f"set_stay_awake({enabled}) rc={r.returncode} out={r.stdout!r} err={r.stderr!r}", flush=True)


class ScreenSaverInhibitBridge(dbus.service.Object):
    def __init__(self, bus):
        super().__init__(bus, OBJECT_PATH)
        self.bus = bus
        self.next_cookie = 1
        self.inhibitors = {}  # cookie -> sender unique name
        # NameOwnerChanged fires for every bus name change; watch_name_owner()
        # is meant for well-known names, not per-call unique names like
        # ":1.123", so we filter this firehose ourselves instead.
        bus.add_signal_receiver(
            self._on_name_owner_changed,
            signal_name="NameOwnerChanged",
            dbus_interface="org.freedesktop.DBus",
            bus_name="org.freedesktop.DBus",
        )

    def _apply(self):
        set_stay_awake(bool(self.inhibitors))

    def _on_name_owner_changed(self, name, old_owner, new_owner):
        if new_owner:
            return
        removed = [c for c, s in self.inhibitors.items() if s == name]
        if not removed:
            return
        for cookie in removed:
            del self.inhibitors[cookie]
        self._apply()

    @dbus.service.method(IFACE, in_signature="ss", out_signature="u", sender_keyword="sender")
    def Inhibit(self, application_name, reason_for_inhibit, sender=None):
        cookie = self.next_cookie
        self.next_cookie += 1
        self.inhibitors[cookie] = sender
        self._apply()
        return cookie

    @dbus.service.method(IFACE, in_signature="u")
    def UnInhibit(self, cookie):
        self.inhibitors.pop(cookie, None)
        self._apply()


def main():
    dbus.mainloop.glib.DBusGMainLoop(set_as_default=True)
    bus = dbus.SessionBus()
    # Must keep a reference: an unreferenced BusName is garbage-collected
    # almost immediately, which releases the name right after acquiring it.
    bus_name = dbus.service.BusName(BUS_NAME, bus, do_not_queue=True)
    ScreenSaverInhibitBridge(bus)
    GLib.MainLoop().run()


if __name__ == "__main__":
    main()
